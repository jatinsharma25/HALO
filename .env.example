# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, no setup required):
DATABASE_URL=sqlite:///./eyespy.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/eyespy

# ── Auth ──────────────────────────────────────────────────────────────────────
# Change this in production — any long random string works
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# Seeded account passwords. Unset, the seed uses the defaults published in the
# README — fine for a local run, unsafe for anything reachable. Set these before
# the FIRST start; the seed only runs on an empty database.
# SEED_ADMIN_PASSWORD=
# SEED_OPERATOR_PASSWORD=
# SEED_RESPONDER_PASSWORD=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Stream (Phase 2) ──────────────────────────────────────────────────────────
# Blur detected people in MJPEG stream output (whole person, not just the face —
# privacy; no person-box data is stored either way)
BLUR_FACES=true
# JPEG compression quality for stream (1–100)
STREAM_JPEG_QUALITY=75
# Target FPS for MJPEG stream
STREAM_FPS=15

# ── Evidence (Phase 3) ────────────────────────────────────────────────────────
# Directory where evidence clip MP4s are stored
EVIDENCE_DIR=./evidence_clips
